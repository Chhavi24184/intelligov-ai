# ==========================================================
# IntelliGov AI — Environment Variables (Example)
# Copy this file to `.env` inside `backend/` and configure.
# No real credentials required for the current mock build.
# ==========================================================

# ---------- App Configuration ----------
APP_NAME=IntelliGov AI
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ---------- CORS ----------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- IBM watsonx.ai (Placeholder — not required for mock build) ----------
IBM_WATSONX_API_KEY=your_ibm_watsonx_api_key_here
IBM_WATSONX_PROJECT_ID=your_watsonx_project_id_here
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com
IBM_WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# ---------- IBM watsonx Assistant (Placeholder) ----------
IBM_WATSONX_ASSISTANT_API_KEY=your_watsonx_assistant_api_key_here
IBM_WATSONX_ASSISTANT_ID=your_assistant_id_here
IBM_WATSONX_ASSISTANT_URL=https://api.us-south.assistant.watson.cloud.ibm.com

# ---------- IBM watsonx Orchestrate (Placeholder) ----------
IBM_WATSONX_ORCHESTRATE_API_KEY=your_orchestrate_api_key_here
IBM_WATSONX_ORCHESTRATE_INSTANCE_URL=https://your-orchestrate-instance-url

# ---------- IBM App ID (Placeholder — for production auth upgrade) ----------
IBM_APPID_CLIENT_ID=your_app_id_client_id
IBM_APPID_CLIENT_SECRET=your_app_id_client_secret
IBM_APPID_OAUTH_SERVER_URL=https://us-south.appid.cloud.ibm.com/oauth/v4/your_tenant_id

# ---------- IBM Cloud Object Storage (Placeholder — future upgrade) ----------
IBM_COS_API_KEY=your_cos_api_key
IBM_COS_INSTANCE_CRN=your_cos_instance_crn
IBM_COS_BUCKET_NAME=intelligov-ai-storage
IBM_COS_ENDPOINT=https://s3.us-south.cloud-object-storage.appdomain.cloud

# ---------- Vector Store (ChromaDB — Local) ----------
CHROMA_DB_PATH=./backend/knowledge/chroma_db
CHROMA_COLLECTION_NAME=intelligov_opportunities
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---------- Auth (JWT Stub) ----------
JWT_SECRET_KEY=dev-only-stub-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# ---------- Session / Orchestrator ----------
SESSION_STORE_BACKEND=in-memory
ORCHESTRATOR_STATUS_POLL_INTERVAL_MS=1000

# ---------- Logging ----------
LOG_LEVEL=INFO
LOG_FORMAT=json
