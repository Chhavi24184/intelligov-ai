# ==========================================================
# IntelliGov AI — Environment Variables
# Copy this file to `.env` inside `backend/` or configure in environment.
# ==========================================================

# ---------- Google Gemini API Key ----------
# Required for Gemini LLM responses in IntelliGov AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ---------- App Configuration ----------
APP_NAME=IntelliGov AI
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ---------- Database ----------
DATABASE_URL=sqlite:///./intelligov.db

# ---------- Auth (JWT) ----------
JWT_SECRET_KEY=dev-only-stub-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60